{
  "version": "0.2.0",
  "configurations": [
      {
        "name": "delv",
        "type": "go",
        "request": "attach",
        "mode": "remote",
        "remotePath": "/app",
        "substitutePath": [
          {
            "from": "${workspaceFolder}/backend",
            "to": "/app"
          }
        ],
        "port": 2345,
        "host": "localhost",
        "cwd": "${workspaceFolder}/backend",
        "showLog": true,
        "trace": "verbose",
        "apiVersion": 2
      }
  ]
}
