{
  "name": "Go CSV Full-Stack Development",
  "dockerComposeFile": "compose.devcontainer.yaml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

    // ホストの .env をコンテナ内で読み込む
  "runArgs": [
    "--env-file", "${localWorkspaceFolder}/backend/.env"
  ],
  
  // 開発に必要な機能を設定
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // VS Code拡張機能の自動インストール
  "customizations": {
    "vscode": {
      "extensions": [
        // Go開発用
        "golang.go",
        "ms-vscode.vscode-json",
        
        // Frontend開発用
        "ms-vscode.vscode-typescript-next",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        
        // データベース用
        "ms-vscode.vscode-postgresql",
        
        // 便利なツール
        "ms-vscode.vscode-thunder-client",
        "redhat.vscode-yaml",
        "ms-vscode-remote.remote-containers",
        "seatonjiang.gitmoji-vscode"


      ],
      
      // 設定
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        
        "go.coverOnTestPackage": true,
        "go.formatTool": "goimports",
        
        "typescript.preferences.quoteStyle": "single",
        "prettier.printWidth": 100,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        }
      }
    }
  },

  // コンテナ起動時に実行されるコマンド
  "postCreateCommand": "npm install --prefix frontend && go mod download",
  
  // ポートフォワーディング設定
  "forwardPorts": [3000, 8080, 2345, 5432],
  "portsAttributes": {
    "3000": {
      "label": "Frontend Dev Server",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "2345": {
      "label": "Go Debug Port",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },

  // リモートユーザー設定
  "remoteUser": "root"
}
