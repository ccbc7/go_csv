FROM node:current-slim AS builder

WORKDIR /usr/src/app

# パッケージファイルをコピー
COPY artWork/package*.json ./

# 依存関係をインストール
RUN npm ci

# アプリケーションファイルをコピー
COPY artWork/ .

# ビルド実行
RUN npm run build

# 本番用イメージ
FROM node:current-slim AS production

WORKDIR /usr/src/app

# パッケージファイルをコピー
COPY artWork/package*.json ./

# 本番依存関係のみインストール
RUN npm ci --only=production

# ビルド結果をコピー
COPY --from=builder /usr/src/app/build ./build

# 環境変数
ENV NODE_ENV=production

# ポート3000を公開
EXPOSE 3000

# 本番サーバーを起動
CMD ["npm", "start"]
